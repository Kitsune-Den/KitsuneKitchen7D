<?xml version="1.0" encoding="UTF-8"?>
<configs>

	<!-- Honey-tea merge: hide the vanilla Honey Tea recipe so our Herbal Honey Tea
	     (buffed: +30 water, +12 food, +10 heal, Herbal Remedy + infection cure) is the
	     only craftable honey tea. Vanilla item stays for loot/traders, just not craftable. -->
	<remove xpath="/recipes/recipe[@name='drinkJarHoneyTea']"/>

