<?xml version="1.0" encoding="UTF-8"?>
<configs>

	<!-- ============================================================ -->
	<!-- SHAM SANDWICH VENDOR FIX                                      -->
	<!-- Makes Sham Sandwiches sellable to traders for ~2 dukes        -->
	<!-- ============================================================ -->
	<set xpath="/items/item[@name='foodShamSandwich']/property[@name='SellableToTrader']/@value">true</set>
	<set xpath="/items/item[@name='foodShamSandwich']/property[@name='EconomicValue']/@value">10</set>

	<!--
	  Notes for every item below:
	  - SmellUse is read by ItemActionEat from the Action0 class, NOT the item root.
	    Extends deep-merges Action0, so a one-line Action0 override is enough.
	  - Effect groups are never inherited through Extends, so each item sets its own
	    Farmer set-bonus cvars (foodHealthFarmer / foodStaminaFarmer) and, for drinks,
	    the vanilla extinguish-fire group.
	-->

	<!-- ============================================================ -->
	<!-- SIMPLE DISHES — From raw ingredients, early-game friendly      -->
	<!-- ============================================================ -->

	<!-- Fox's Hash: Potato + Egg on the grill -->
	<append xpath="/items">
		<item name="foodKKFoxHash">
			<property name="Extends" value="foodBakedPotato"/>
			<property name="CustomIcon" value="foodBakedPotato"/>
			<property name="CustomIconTint" value="f0c050"/>
			<property name="EconomicValue" value="25"/>
			<property name="Group" value="Food/Cooking,CFFood/Cooking"/>
			<property class="Action0">
				<property name="SmellUse" value="0"/>
			</property>
			<effect_group tiered="false" name="KK Fox Hash">
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="$foodAmountAdd" operation="add" value="22"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="foodHealthAmount" operation="add" value="8"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="foodHealthFarmer" operation="set" value="8">
					<requirement name="HasBuff" buff="buffFarmerSetBonus"/></triggered_effect>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar=".foodStaminaBonusAdd" operation="add" value="10"/>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="ModifyCVar" cvar="foodStaminaFarmer" operation="set" value="10">
					<requirement name="HasBuff" buff="buffFarmerSetBonus"/></triggered_effect>
				<triggered_effect trigger="onSelfPrimaryActionEnd" action="AddBuff" buff="buffProcessConsumables"/>
				<display_value name="dSmellUse" value="0"/>
			</effect_group>
		</item>
	</append>

