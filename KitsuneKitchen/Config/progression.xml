<configs>

	<!-- ============================================================ -->
	<!-- KITSUNE KITCHEN — PROGRESSION                                  -->
	<!-- ============================================================ -->
	<!--
	  Kitsune Kitchen recipes are unlocked by default (the recipes in
	  recipes.xml are NOT tagged "learnable"), so they need no progression
	  gating here.

	  This was changed from the old magazine-gated approach (appending
	  RecipeTagUnlocked to the vanilla craftingFood skill). That approach
	  broke on progression overhauls such as "Learn By Doing", which
	  replace the entire /progression tree with <set xpath="/progression">
	  and remove the vanilla craftingFood crafting_skill — leaving our
	  <append> with no target, so the recipes never unlocked. Unlocking by
	  default keeps the mod compatible with vanilla and every overhaul.
	-->

</configs>
